<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Static assets, PHP, and built files
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA fallback (HashRouter still benefits for direct path hits)
  RewriteRule ^ index.html [L]
</IfModule>
